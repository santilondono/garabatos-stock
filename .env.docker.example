# Plantilla para el NAS: copiar a .env y completar. Sin valores reales en git.
APP_NAME="Garabatos Stock"
APP_ENV=production
# Generar con: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# URL con la que se entra (p. ej. la de `tailscale serve`): https://<nas>.<tailnet>.ts.net
APP_URL=
# Detrás de `tailscale serve`: confiar en los encabezados X-Forwarded-* del proxy.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Laravel -> MariaDB (servicio `db` del compose). Deben coincidir con MARIADB_* de .env.db.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=garabatos_stock
DB_USERNAME=garabatos
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# SMTP externo: puerto 465 con MAIL_ENCRYPTION=ssl, o 587 con MAIL_ENCRYPTION=tls.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
