# Plantilla para el contenedor MariaDB: copiar a .env.db y completar. Sin valores reales en git.
# Solo se usan al crear el volumen de datos por primera vez.
# MARIADB_DATABASE, MARIADB_USER y MARIADB_PASSWORD deben coincidir con
# DB_DATABASE, DB_USERNAME y DB_PASSWORD del .env.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=garabatos_stock
MARIADB_USER=garabatos
MARIADB_PASSWORD=
